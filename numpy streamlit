import streamlit as st
import numpy as np
import time

st.title("Kükner Kriptoloji - İHA/SİHA Simülasyonu")
st.write("Formül: ((100 / 19) * (pi / 19))^n")

if st.button("Simülasyonu Başlat"):
    pi = np.pi
    temel_katsayi = (100.0 / 19.0) * (pi / 19.0)

    st.write(f"**Temel Çarpan:** {temel_katsayi:.10f}")
    st.markdown("---")

    for n in range(1, 6):
        formul_degeri = np.power(temel_katsayi, n)
        hassas_str = f"{formul_degeri:.50f}"
        kanal_frekansi = 2400 + (int(hassas_str.replace('.', '')[:4]) % 80)
        sifreleme_anahtari = hassas_str[-12:]

        st.success(f"Paket #{n:02d} | Atlanan Frekans: **{kanal_frekansi} MHz** | Anahtar: `{sifreleme_anahtari}`")
        time.sleep(0.1)

    st.balloons()
    st.info("İHA/SİHA Telemetri Koruması Başarıyla Tamamlandı (%100 Benzersizlik).")
